{
  "name": "ghostcn",
  "version": "1.0.1",
  "description": "The shadcn/ui for Ghost CMS themes - component distribution system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ghostcn": "dist/index.js",
    "ghost-ui": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); const path=require('path'); const src=path.resolve('../../registry'); const dest=path.resolve('dist/registry'); if(fs.existsSync(src)){fs.cpSync(src, dest, {recursive:true});}\"",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "test": "node --test dist/test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekbits-Org/ghost-ui.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ghost",
    "ghost-cms",
    "ghost-theme",
    "theme",
    "components",
    "shadcn",
    "cli",
    "handlebars"
  ],
  "author": "Geekbits Org",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Geekbits-Org/ghost-ui/issues"
  },
  "homepage": "https://github.com/Geekbits-Org/ghost-ui#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "prompts": "^2.4.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/prompts": "^2.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
